{
    "monitored_extensions": [
        ".rs",
        ".go",
        ".java",
        ".c",
        ".js",
        ".ts",
        ".py",
        ".cpp"
    ],
    "ignored_directories": [
        ".vscode",
        "env",
        "venv",
        ".lifejacket",
        ".git",
        ".idea",
        ".venv",
        "node_modules",
        "__pycache__"
    ],
    "max_snapshots": 10,
    "max_age_days": 30,
    "debounce_time": 1.0,
    "snapshot_directory_name": ".lifejacket",
    "log_level": "INFO"
}